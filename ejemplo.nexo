arranca

contador = 0
limite = 10
promedio = 0.75
cientifico = 1.25E+03

mientras contador > limite
    inc contador
    muestra "Contador actualizado"
hacer

si contador == limite
    muestra "Se alcanzo el limite"
sino
    muestra "El limite aun no se alcanza"
cierra

resultado = (contador * 2) / 4
resto = contador % 2
nombre = "modelo_prueba.nexo"

cierra
